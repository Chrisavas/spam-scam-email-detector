# Αντίγραψε αυτό το αρχείο σε .env και συμπλήρωσε τα keys σου
#   Linux/Mac : cp .env.example .env
#   Windows   : copy .env.example .env

# Ποιος provider θα χρησιμοποιηθεί: "mock" | "anthropic" | "openai" | "gemini"
#   mock  -> τρέχει offline, ΧΩΡΙΣ API key (default, ιδανικό για demo/tests)
#   Για πραγματικές απαντήσεις, βάλε "anthropic" (ή openai/gemini) + το ανάλογο key.
AI_PROVIDER=mock

# Anthropic Claude API (προτιμώμενο για πραγματικό demo)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (εναλλακτικά)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (εναλλακτικά)
GEMINI_API_KEY=your_gemini_api_key_here
